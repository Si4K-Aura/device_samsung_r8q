# mount point  fstype  device  device2  flags
/system_root   ext4   system                                           flags=display="System";logical
/vendor        ext4   vendor                                           flags=display="Vendor";logical
/product       ext4   product                                          flags=display="Product";logical
/odm           ext4   odm                                              flags=display="ODM";logical
/data          f2fs   /dev/block/bootdevice/by-name/userdata           flags=display="Data";wipeingui;wipeduringfactoryreset
/cache         ext4   /dev/block/bootdevice/by-name/cache              flags=display="Cache";wipeingui
/metadata      ext4   /dev/block/bootdevice/by-name/metadata           flags=display="Metadata"
/efs           ext4   /dev/block/bootdevice/by-name/efs                flags=display="EFS";backup=1
/persist       ext4   /dev/block/bootdevice/by-name/persist            flags=display="Persist";backup=1
/boot          emmc   /dev/block/bootdevice/by-name/boot               flags=display="Boot";backup=1;flashimg=1
/recovery      emmc   /dev/block/bootdevice/by-name/recovery           flags=display="Recovery";backup=1;flashimg=1
/dtbo          emmc   /dev/block/bootdevice/by-name/dtbo               flags=display="Dtbo";backup=1;flashimg=1
/vbmeta        emmc   /dev/block/bootdevice/by-name/vbmeta             flags=display="Vbmeta";backup=1;flashimg=1
/misc          emmc   /dev/block/bootdevice/by-name/misc               
/external_sd   auto   /dev/block/mmcblk0p1                             /dev/block/mmcblk0 flags=display="Micro SD";storage;wipeingui;removable
/usb_otg       auto   /dev/block/sde1                                  /dev/block/sde flags=display="USB OTG";storage;wipeingui;removable
